      "task_group": "DataIngestionMovement_sintetico_incr.RawVaultStorageLoadToDataWarehouseRawPhrase",
      "templated_fields": {
        "configuration": {
          "load": {
            "createDisposition": "CREATE_IF_NEEDED",
            "destinationTable": {
              "datasetId": "raw",
              "projectId": "modular-aileron-191222",
              "tableId": "bigquery_example_sintetico_incr${{ macros.ds_format(logical_date, '%Y-%m-%dT%H:%M:%S+00:00', '%Y%m%d%H') }}"
            },
            "hivePartitioningOptions": {
              "mode": "AUTO",
              "sourceUriPrefix": "gs://dotz-datalake-dev-l2-raw-vault/bigquery/example/sintetico_incr"
            },
            "schema": {
              "fields": [
                {
                  "description": null,
                  "fields": null,
                  "mode": null,
                  "name": "data",
                  "policy_tags": {
                    "names": []
                  },
                  "type": "STRING"
                },
                {
                  "description": "Airflow logical date timestamp",
                  "fields": null,
                  "mode": null,
                  "name": "airflow_logical_date",
                  "policy_tags": {
                    "names": []
                  },
                  "type": "TIMESTAMP"
                },
                {
                  "description": "Airflow $PWD env variable value",
                  "fields": null,
                  "mode": null,
                  "name": "pwd_env_var",
                  "policy_tags": {
                    "names": []
                  },
                  "type": "STRING"
                },
                {
                  "description": "Value of the variable set in environment.yaml",
                  "fields": null,
                  "mode": null,
                  "name": "debussy_env_project",
                  "policy_tags": {
                    "names": []
                  },
                  "type": "STRING"
                },
                {
                  "description": "Example of a default value if variable does not exist in env",
                  "fields": null,
                  "mode": null,
                  "name": "env_default_value_example",
                  "policy_tags": {
                    "names": []
                  },
                  "type": "STRING"
                }
              ]
            },
            "schemaUpdateOptions": null,
            "sourceFormat": "PARQUET",
            "sourceUris": [
              "gs://dotz-datalake-dev-l2-raw-vault/bigquery/example/sintetico_incr/_load_flag=incr/_logical_ts={{ logical_date }}/_ingestion_ts={{ dag_run.start_date }}/*.parquet"
            ],
            "timePartitioning": null,
            "writeDisposition": "WRITE_TRUNCATE"
          }
        },
        "gcp_conn_id": "google_cloud_debussy",
        "impersonation_chain": null,
        "job_id": null,
        "project_id": null
      },
      "trigger_rule": "all_success",
      "upstream": [
        "DataIngestionMovement_sintetico_incr.IngestionSourceToRawVaultStoragePhrase.ExportBigQueryQueryToGcsMotif"
