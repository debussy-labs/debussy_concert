{
  "catchup": false,
  "dag_id": "bigquery_ingestion_incr",
  "default_args": {
    "owner": "debussy"
  },
  "description": "BigQuery incremental ingestion. Overwriting logical partitions and versioning on storage",
  "end_date": null,
  "max_active_runs": 16,
  "schedule": "*/30 * * * *",
  "start_date": "2022-01-01T00:00:00+00:00",
  "tags": [
    "framework:debussy",
    "load:incremental",
    "project:example",
    "source:bigquery",
    "tier:1",
    "type:ingestion"
  ],
  "task_groups": {
