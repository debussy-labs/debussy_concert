        "dataset_id": "raw",
        "gcp_conn_id": "google_cloud_debussy",
        "impersonation_chain": null,
        "project_id": "modular-aileron-191222",
        "table_id": "bigquery_example_sintetico_incr"
      },
      "trigger_rule": "all_success",
      "upstream": [
        "DataIngestionMovement_sintetico_incr.CreateOrUpdateRawTablePhrase.CreateBigQueryTableMotif.create_empty_table"
