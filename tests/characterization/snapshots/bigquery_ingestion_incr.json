        "gcp_conn_id": "google_cloud_debussy",
        "gcs_schema_object": null,
        "google_cloud_storage_conn_id": "google_cloud_default",
        "impersonation_chain": null,
        "project_id": "modular-aileron-191222",
        "table_id": "bigquery_example_sintetico_incr",
        "table_resource": {
          "schema": {
            "fields": [
              {
                "description": null,
                "fields": null,
                "mode": null,
                "name": "data",
                "policy_tags": {
                  "names": []
                },
                "type": "STRING"
              },
              {
                "description": "Airflow logical date timestamp",
                "fields": null,
                "mode": null,
                "name": "airflow_logical_date",
                "policy_tags": {
                  "names": []
                },
                "type": "TIMESTAMP"
              },
              {
                "description": "Airflow $PWD env variable value",
                "fields": null,
                "mode": null,
                "name": "pwd_env_var",
                "policy_tags": {
                  "names": []
                },
                "type": "STRING"
              },
              {
                "description": "Value of the variable set in environment.yaml",
                "fields": null,
                "mode": null,
                "name": "debussy_env_project",
                "policy_tags": {
                  "names": []
                },
                "type": "STRING"
              },
              {
                "description": "Example of a default value if variable does not exist in env",
                "fields": null,
                "mode": null,
                "name": "env_default_value_example",
                "policy_tags": {
                  "names": []
                },
                "type": "STRING"
              },
              {
                "description": "incr = incremental data ingestion; full = full data ingestion",
                "fields": null,
                "mode": null,
                "name": "_load_flag",
                "policy_tags": {
                  "names": []
                },
                "type": "STRING"
              },
              {
                "description": "Airflow logical date",
                "fields": null,
                "mode": null,
                "name": "_logical_ts",
                "policy_tags": {
                  "names": []
                },
                "type": "TIMESTAMP"
              },
              {
                "description": "Clock time at when the ingestion was executed",
                "fields": null,
                "mode": null,
                "name": "_ingestion_ts",
                "policy_tags": {
                  "names": []
                },
                "type": "TIMESTAMP"
              }
            ]
          },
          "timePartitioning": {
            "expirationMs": null,
            "field": "_logical_ts",
            "type": "HOUR"
          }
        }
      },
      "trigger_rule": "all_success",
      "upstream": [
        "DataIngestionMovement_sintetico_incr.StartPhrase.StartMotif.log_input"
      ]
