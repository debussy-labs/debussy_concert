      "task_group": "DataIngestionMovement_sintetico_incr.IngestionSourceToRawVaultStoragePhrase",
      "templated_fields": {
        "configuration": {
          "query": {
            "createDisposition": null,
            "destinationTable": null,
            "query": "\n    EXPORT DATA OPTIONS(overwrite=false,format='PARQUET',uri='gs://dotz-datalake-dev-l2-raw-vault/bigquery/example/sintetico_incr/_load_flag=incr/_logical_ts={{ logical_date }}/_ingestion_ts={{ dag_run.start_date }}/*.parquet')\n    AS SELECT 'dado' as data, TIMESTAMP '{{ logical_date }}' as airflow_logical_date, '/snapshot/pwd' as pwd_env_var, 'modular-aileron-191222' as debussy_env_project, 'default_value' as env_default_value_example\n\n    ",
            "timePartitioning": null,
            "useLegacySql": false,
            "writeDisposition": null
          }
        },
        "gcp_conn_id": "google_cloud_debussy",
        "impersonation_chain": null,
        "job_id": null,
        "project_id": null
      },
      "trigger_rule": "all_success",
      "upstream": [
        "DataIngestionMovement_sintetico_incr.CreateOrUpdateRawTablePhrase.CreateBigQueryTableMotif.update_table_resources"
      ]
    },
